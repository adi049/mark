# ------------------------------------------------------------------
# MARKIPIE environment variables
#
# Copy this file to .env and fill in real values. Only variables
# prefixed with VITE_ are embedded into the frontend bundle, so no
# private key should ever carry that prefix.
#
# .env, .env.local and .env.*.local are git-ignored. Never commit
# real credentials.
# ------------------------------------------------------------------

# Supabase project (client platform, database and auth).
# Use the project URL and the ANON key from Project Settings > API.
# The anon key is safe in the browser: row level security protects the
# data. The service role key must never appear in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth client id. Not used by the current build: the Drive
# integration keeps its client id and secret server side (see
# supabase/README.md). Kept here for future client-side Google features.
VITE_GOOGLE_CLIENT_ID=

# Google Drive API base (optional). Defaults to the Supabase edge function
# at <VITE_SUPABASE_URL>/functions/v1/drive. Never put Google secrets here;
# the client secret stays on the server side (see supabase/README.md).
VITE_DRIVE_API_URL=

# ------------------------------------------------------------------
# Build-time variables (set in the deployment environment, not a secret)
# ------------------------------------------------------------------

# Final public domain of the site, without a trailing slash. When set at
# build time the production output includes sitemap.xml with absolute
# URLs and points robots.txt at it. Without it no sitemap is emitted.
# Example: SITE_URL=https://markipie.com
SITE_URL=

# ==================================================================
# SERVER-SIDE / SECRET VARIABLES
#
# These are NEVER part of the frontend bundle and must NEVER be given a
# VITE_ prefix or placed in this file with real values. They belong to
# the Supabase Edge Function only, set with:
#
#   supabase secrets set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=... \
#     SUPABASE_SERVICE_ROLE_KEY=...
#
#   GOOGLE_CLIENT_ID           Google OAuth client id (Drive connect flow)
#   GOOGLE_CLIENT_SECRET       Google OAuth client secret
#   SUPABASE_SERVICE_ROLE_KEY  bypasses RLS; used only inside the function
#
# See supabase/README.md for the full deployment walkthrough.
# ==================================================================
